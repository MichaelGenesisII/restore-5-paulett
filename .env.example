# Supabase Postgres. DATABASE_URL = transaction pooler (6543).
# DIRECT_URL = direct/session (5432) for Prisma migrate / db push.
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key — Dashboard → Project Settings → API → anon (public).
# Needed for pot-creator sign-in in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# JWT Secret — Dashboard → Project Settings → API → JWT Secret.
# Lets Host/Admin APIs verify access tokens locally (no Auth HTTP round-trip).
# Strongly recommended; without it every /api/admin/* call hits Supabase Auth.
SUPABASE_JWT_SECRET=
# Service role — server only. Needed for pot cover uploads + creating creator accounts.
# Dashboard → Project Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=
# Create a public Storage bucket named `pot-covers` (Dashboard → Storage).
# Allow public read; uploads go through this app with the service role.
# Auth: disable “Confirm email” in Authentication → Providers → Email
# (we create users with email_confirm: true and send the password ourselves).

# Bootstrap staff: /admin allowlist AND recipients of direct /give gift notices
# (+ contact-form pings). Extra admins in /admin/settings → Admins get /admin
# only — they do not receive /give gift emails (intentional).
# Each address must also have a Supabase Auth user (same as Host login).
# Example: ADMIN_EMAILS="hello@pvnbelfast.org,ops@pvnbelfast.org"
ADMIN_EMAILS=

# Vercel Cron → /api/cron/purge-stale-donations
# Set the same value in Vercel env. Vercel sends Authorization: Bearer <CRON_SECRET>.
# Query-string ?secret= is not accepted.
CRON_SECRET=

# Stripe — use sk_test_… until the money path is proven; sk_live_… only on production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Required in production (checkout success/cancel + email links).
# Local: http://localhost:3000 — Production: https://your-domain.com (no trailing slash).
NEXT_PUBLIC_APP_URL=

# Google Places (New) — Gift Aid address lookup on /give.
# Server-only key. Restrict to Places API in Google Cloud Console.
# If empty, the form falls back to manual address entry only.
GOOGLE_PLACES_API_KEY=

# Building fund target is edited in /admin/building-fund (DB), not env.

# Resend — all app email (giving receipts, host invites, admin).
# Content/branding is Restore 5 Paulett / PVN Belfast in code (not env).
# Only swap these when you move off temporary keys / onto your PVN domain:
#   RESEND_API_KEY     — Resend dashboard API key
#   EMAIL_FROM_ADDRESS — must be a verified sender/domain in that Resend account
#   EMAIL_FROM_NAME    — display name (defaults to "PVN Belfast" if unset)
# Links in emails use NEXT_PUBLIC_APP_URL.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
# Reserved for future list-unsubscribe signing.
UNSUBSCRIBE_SECRET=
